APP_NAME="Gedocs Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

# Public demo mode: loads fictional data on `db:seed`, enables one-click demo login,
# protects the demo accounts and allows `php artisan demo:reset`. Keep false outside the demo.
APP_DEMO=false
# DEMO_PASSWORD=demo1234

# Institution identity (every value is fictional; see config/institution.php)
INSTITUTION_NAME="Institución Demo"
INSTITUTION_SHORT_NAME=Demo
INSTITUTION_TAX_ID=900.000.000-0
INSTITUTION_AREA="Área de gestión documental"
INSTITUTION_CITY="Sede Central"
INSTITUTION_FILING_PREFIX=DEMO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gedocs
DB_USERNAME=root
DB_PASSWORD=

# Sessions live in the database (table created by the users migration), not in a cookie payload.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true only when the site is served over HTTPS, otherwise login breaks.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The demo never sends real email: messages are written to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@demo.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Sanctum cookie auth for the React frontend (same-origin) and the origins allowed by CORS.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000
