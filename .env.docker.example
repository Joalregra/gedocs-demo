# Local Docker run (http://localhost). Copy to `.env` and set APP_KEY (see README).
# This is for trying the app on your own machine only; production uses .env.production.example.

APP_NAME="Gedocs Demo"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

APP_DOMAIN=http://localhost
ACME_EMAIL=local@demo.test

APP_DEMO=true

INSTITUTION_NAME="Institución Demo"
INSTITUTION_SHORT_NAME=Demo
INSTITUTION_TAX_ID=900.000.000-0
INSTITUTION_AREA="Área de gestión documental"
INSTITUTION_CITY="Sede Central"
INSTITUTION_FILING_PREFIX=DEMO

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=gedocs
DB_USERNAME=gedocs
DB_PASSWORD=local-only-password
DB_ROOT_PASSWORD=local-only-root-password

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@demo.test"

SANCTUM_STATEFUL_DOMAINS=localhost
CORS_ALLOWED_ORIGINS=http://localhost
