# Production environment of the public demo (Docker). Copy to `.env` on the server and edit.
# The real `.env` is created by hand on the server and is never committed.

APP_NAME="Gedocs Demo"
APP_ENV=production
APP_DEBUG=false
# Generate once with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://gedocs.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

# Domain served by Caddy (certificate is requested automatically) and contact for Let's Encrypt.
APP_DOMAIN=gedocs.example.com
ACME_EMAIL=you@example.com

# Public demo mode: fictional data, one-click login, protected demo accounts, nightly reset.
APP_DEMO=true

INSTITUTION_NAME="Institución Demo"
INSTITUTION_SHORT_NAME=Demo
INSTITUTION_TAX_ID=900.000.000-0
INSTITUTION_AREA="Área de gestión documental"
INSTITUTION_CITY="Sede Central"
INSTITUTION_FILING_PREFIX=DEMO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database (the `db` container of docker-compose.yml). Use long random values.
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=gedocs
DB_USERNAME=gedocs
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Sessions in the database; the cookie is only sent over HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# Nothing is queued in the demo (mail goes to the log), so no worker container is needed.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# The demo never sends real email: messages are written to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@demo.test"
MAIL_FROM_NAME="${APP_NAME}"

# Same-origin cookie auth for the React frontend and the only origin CORS allows.
SANCTUM_STATEFUL_DOMAINS=gedocs.example.com
CORS_ALLOWED_ORIGINS=https://gedocs.example.com
SANCTUM_TOKEN_EXPIRATION=1440

# Image published by CI (see .github/workflows/docker.yml).
# APP_IMAGE=ghcr.io/your-github-user/gedocs-demo:latest
